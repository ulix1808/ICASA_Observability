[Unit]
Description=AppDynamics Database Agent - ICASA DEV
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=appdynamics
Group=appdynamics
WorkingDirectory=/opt/appdynamics/db-agent

Environment="JAVA_HOME=/usr/lib/jvm/java-17-openjdk"
Environment="DB_AGENT_HOME=/opt/appdynamics/db-agent"

ExecStart=/opt/appdynamics/db-agent/db-agent.sh \
  -Dappdynamics.controller.hostName=10.250.5.12 \
  -Dappdynamics.controller.port=443 \
  -Dappdynamics.controller.ssl.enabled=true \
  -Dappdynamics.agent.accountName=teresa202606020142139 \
  -Dappdynamics.agent.accountAccessKey=awo27vhp6nrw \
  -Ddbagent.name=ICASA-DEV-DB-AGENT \
  -Djavax.net.ssl.trustStore=/opt/appdynamics/db-agent/conf/truststore.jks \
  -Djavax.net.ssl.trustStorePassword=changeit

Restart=on-failure
RestartSec=30
StandardOutput=append:/opt/appdynamics/db-agent/logs/agent-stdout.log
StandardError=append:/opt/appdynamics/db-agent/logs/agent-stderr.log

[Install]
WantedBy=multi-user.target
