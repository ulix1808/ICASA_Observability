# =============================================================================
# ICASA Observability — Variables de entorno (DEV)
# Copiar a .env y completar. NO commitear .env al repositorio.
# =============================================================================

# --- AppDynamics Controller (SaaS) ---
APPD_CONTROLLER_HOST=teresa202606020142139.saas.appdynamics.com
APPD_CONTROLLER_PORT=443
APPD_CONTROLLER_SSL=true
APPD_ACCOUNT_NAME=teresa202606020142139
APPD_ACCOUNT_ACCESS_KEY=CAMBIAR_POR_ACCESS_KEY_REAL
APPD_GLOBAL_ACCOUNT_NAME=teresa202606020142139_c3fed800-bd2f-48b9-9c6d-143c9df5395c

# Analytics Events API (SAP)
APPD_ANALYTICS_HOST=analytics.api.appdynamics.com
APPD_ANALYTICS_PORT=443

# --- Proxy Nginx (DMZ) ---
PROXY_HOST=10.250.5.12
PROXY_FQDN=appd-proxy.icasa.local
PROXY_PORT=443

# --- Servidores LAN ---
# MONITOR: Database Agent + Splunk UF
MONITOR_HOST=10.2.32.179
MONITOR_HOSTNAME=STMPLPOCOB-MONITOR

# COLECTOR: HTTP SDK (SAP) + SC4SNMP
COLLECTOR_HOST=10.2.32.180
COLLECTOR_HOSTNAME=STMPLPOCOB-COLECTOR

# --- Database Agent ---
DB_AGENT_HOME=/opt/appdynamics/db-agent
DB_AGENT_NAME=ICASA-DEV-DB-AGENT
SQL_SERVER_HOST=CAMBIAR_POR_IP_SQL_SERVER
SQL_SERVER_PORT=1433
SQL_SERVER_USER=CAMBIAR_POR_USUARIO_MONITOR
# SQL_SERVER_PASSWORD en archivo separado: /opt/appdynamics/db-agent/conf/sql-password.txt

# --- HTTP SDK (SAP) ---
HTTP_SDK_HOME=/opt/appdynamics/appdhttpsdk
HTTP_SDK_PORT=8080
SDK_MANAGER_PORT=7999

# --- Splunk Cloud ---
# Host HEC sin https:// (usado por generate-nginx-configs.sh)
SPLUNK_CLOUD_HOST=input-prd-pendiente.splunkcloud.com
SPLUNK_HEC_URL=https://CAMBIAR_POR_HEC_ENDPOINT
SPLUNK_HEC_TOKEN=CAMBIAR_POR_HEC_TOKEN
SPLUNK_UF_HOME=/opt/splunkforwarder

# --- Certificados ---
CA_CERT_PATH=/etc/pki/tls/certs/icasa-ca.crt
PROXY_CERT_PATH=/etc/nginx/ssl/proxy.crt
PROXY_KEY_PATH=/etc/nginx/ssl/proxy.key
